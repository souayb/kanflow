# --- Kanflow Rust API ---
DATABASE_URL=postgresql://kanflow:kanflow@localhost:5432/kanflow
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kanflow
KANFLOW_HOST=0.0.0.0
KANFLOW_PORT=8080

# --- Ollama (local LLM) ---
# Model to auto-pull on docker compose up (also used by ollama-pull service)
OLLAMA_MODEL=llama3.2

# --- GitHub one-way sync (optional) ---
# When TOKEN + OWNER + REPO are all set, creating a task in Kanflow opens a
# GitHub Issue in that repo. If PROJECT_NUMBER is set, the issue is also added
# to that user/org Projects v2 board. docker-compose reads this .env automatically.
#
# Personal Access Token:
#   • Classic PAT: scopes `repo` + `project`.
#   • Fine-grained PAT: Issues=Read/Write and Projects=Read/Write on the repo.
GITHUB_TOKEN=
GITHUB_OWNER=your-user-or-org
GITHUB_REPO=your-repo
# Projects v2 number — the N in https://github.com/users/<owner>/projects/N
# (or /orgs/<owner>/projects/N). Leave blank to skip the board.
GITHUB_PROJECT_NUMBER=
# Set to `true` if GITHUB_OWNER is an organization.
GITHUB_OWNER_IS_ORG=false

# Preferred: GitHub App user authorization. In the GitHub App settings, set
# the callback URL to:
#   http://localhost:3000/api/v1/integrations/github/callback
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/v1/integrations/github/callback
FRONTEND_PUBLIC_URL=http://localhost:3000

# --- Mobile (Expo) ---
# Public Keycloak URL as seen from a phone on your LAN, e.g. http://192.168.1.50:8180
KEYCLOAK_PUBLIC_URL=http://localhost:8180
